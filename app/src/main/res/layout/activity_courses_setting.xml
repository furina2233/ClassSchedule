<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        tools:context=".CoursesSettingActivity">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                  android:orientation="vertical">
        <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp">
            <TextView
                    android:id="@+id/tv_course_setting_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/course_settings"
                    android:textSize="20sp"
                    android:textColor="@color/title_text"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            <ImageButton
                    android:id="@+id/btn_course_setting"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_more_horiz"
                    app:layout_constraintBottom_toBottomOf="@id/tv_course_setting_title"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_course_setting_title"
                    app:tint="@color/gray"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <!--        放置课程卡片的容器-->
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
                    android:id="@+id/sv_courses" tools:ignore="MissingConstraints">
            <LinearLayout
                    android:id="@+id/ll_course_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <!--        没有课程时显示的文本-->
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
              android:id="@+id/tv_no_courses"
              android:text="@string/no_courses"
              android:gravity="center"
              android:textColor="@color/gray"
              android:visibility="gone"
              app:layout_constraintTop_toTopOf="parent"
              app:layout_constraintBottom_toBottomOf="parent"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="invisible"
            app:layout_constraintGuide_end="80dp"/>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_add_course"
            style="@style/Widget.Material3.FloatingActionButton.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/add_course"
            app:srcCompat="@android:drawable/ic_input_add"
            app:tint="@color/white"
            app:backgroundTint="@color/main_theme"
            app:fabSize="normal"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:elevation="6dp"
            app:layout_constraintBottom_toTopOf="@id/guideline_bottom"/>
</androidx.constraintlayout.widget.ConstraintLayout>